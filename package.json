{
  "name": "template-node-library",
  "version": "0.0.3",
  "description": "Template for Node.js library projects.",
  "keywords": [
    "library",
    "node",
    "template",
    "typescript"
  ],
  "homepage": "https://solomou.dev",
  "bugs": {
    "url": "https://github.com/richardsolomou/template-node-library/issues",
    "email": "richard@solomou.dev"
  },
  "license": "MIT",
  "author": {
    "name": "Richard Solomou",
    "email": "richard@solomou.dev",
    "url": "https://solomou.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/template-node-library"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "check": "oxfmt --check . && oxlint --type-aware --deny-warnings .",
    "fix": "oxfmt --write . && oxlint --type-aware --fix .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "policy:check": "ras policy check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "ras-stack": "^0.41.1",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
